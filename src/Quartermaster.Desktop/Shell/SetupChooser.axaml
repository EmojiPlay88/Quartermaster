<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Quartermaster.Desktop.Shell.SetupChooser"
        Title="New game"
        Width="420" Height="390"
        CanResize="False" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="4">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6" Margin="4">
      <Button x:Name="Back" Content="&lt; _Back" MinWidth="75" IsVisible="False" HorizontalContentAlignment="Center" />
      <Button x:Name="Next" Content="_Next &gt;" MinWidth="75" HorizontalContentAlignment="Center" />
      <Button x:Name="Ok" Content="OK" MinWidth="75" IsDefault="True" HorizontalContentAlignment="Center" />
      <Button x:Name="Cancel" Content="Cancel" MinWidth="75" IsCancel="True" HorizontalContentAlignment="Center" />
    </StackPanel>
    <Panel>
      <DockPanel x:Name="GamePanel">
        <!-- Online (Create lobby): lobby name, password and the open-lobby warning, under the difficulty -->
        <Grid x:Name="LobbyPanel" DockPanel.Dock="Bottom" IsVisible="False" Margin="4,6,0,0"
              ColumnDefinitions="88,Auto" RowDefinitions="Auto,Auto,Auto">
          <TextBlock Grid.Row="0" Text="Lobby name:" VerticalAlignment="Center" Margin="4,2" />
          <TextBox x:Name="LobbyNameBox" Grid.Row="0" Grid.Column="1" Width="200" Margin="0,2" />
          <TextBlock Grid.Row="1" Text="Password:" VerticalAlignment="Center" Margin="4,2" />
          <TextBox x:Name="LobbyPasswordBox" Grid.Row="1" Grid.Column="1" Width="200" PasswordChar="*" Margin="0,2" />
          <TextBlock x:Name="OpenWarning" Grid.Row="2" Grid.Column="1" Foreground="DarkGoldenrod" Margin="0,2" />
        </Grid>
        <!-- WinForms GroupBox "Difficulty" -->
        <StackPanel DockPanel.Dock="Bottom" Margin="0,4,0,0">
          <TextBlock Text="Difficulty" Margin="6,0,0,2" />
          <Border BorderBrush="{DynamicResource Classic.BorderBrush}" BorderThickness="1" Padding="6,2,6,4">
            <StackPanel x:Name="Modes" />
          </Border>
        </StackPanel>
        <ListBox x:Name="Setups" />
      </DockPanel>
      <!-- WinForms GroupBox "Players" (the second page) -->
      <DockPanel x:Name="PlayersPanel" IsVisible="False">
        <TextBlock x:Name="PlayersTitle" DockPanel.Dock="Top" Text="Players" Margin="6,0,0,2" />
        <Border x:Name="PlayersFrame" BorderBrush="{DynamicResource Classic.BorderBrush}" BorderThickness="1" Padding="6" />
      </DockPanel>
    </Panel>
  </DockPanel>
</Window>
