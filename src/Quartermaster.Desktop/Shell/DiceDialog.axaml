<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Quartermaster.Desktop.Shell.DiceDialog"
        Title="Custom Roll"
        Width="314" SizeToContent="Height"
        CanResize="False" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <!-- As WinForms DiceDialog: the expression (and Times for Multi-roll), a live error line, OK / Cancel. -->
  <StackPanel Margin="12,10,12,10">
    <Grid ColumnDefinitions="200,20,60" RowDefinitions="Auto,Auto">
      <TextBlock Text="Dice (e.g. 2d6 or 3d10+2):" Margin="0,0,0,4" />
      <TextBox x:Name="Expr" Grid.Row="1" Text="2d6" />
      <TextBlock x:Name="TimesLabel" Grid.Column="2" Text="Times:" Margin="0,0,0,4" />
      <NumericUpDown x:Name="Times" Grid.Column="2" Grid.Row="1" Minimum="1" Maximum="20" Value="3" Increment="1" FormatString="0" />
    </Grid>
    <TextBlock x:Name="Error" Foreground="Firebrick" Height="18" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6" Margin="0,6,0,0">
      <Button x:Name="Ok" Content="OK" MinWidth="75" IsDefault="True" HorizontalContentAlignment="Center" />
      <Button x:Name="Cancel" Content="Cancel" MinWidth="75" IsCancel="True" HorizontalContentAlignment="Center" />
    </StackPanel>
  </StackPanel>
</Window>
