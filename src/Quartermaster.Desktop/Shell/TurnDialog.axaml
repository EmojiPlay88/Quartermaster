<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Quartermaster.Desktop.Shell.TurnDialog"
        Title="Set Turn"
        Width="304" SizeToContent="Height"
        CanResize="False" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <!-- As WinForms TurnDialog: turn number (at least 1) and an optional phase, OK / Cancel. -->
  <StackPanel Margin="12,10,12,10">
    <Grid ColumnDefinitions="58,*" RowDefinitions="Auto,Auto">
      <TextBlock Text="Turn:" VerticalAlignment="Center" />
      <NumericUpDown x:Name="TurnBox" Grid.Column="1" Width="100" HorizontalAlignment="Left" Minimum="1" Maximum="99999" Increment="1" FormatString="0" />
      <TextBlock Grid.Row="1" Text="Phase:" VerticalAlignment="Center" Margin="0,6,0,0" />
      <TextBox x:Name="PhaseBox" Grid.Row="1" Grid.Column="1" Margin="0,6,0,0" />
    </Grid>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6" Margin="0,12,0,0">
      <Button x:Name="Ok" Content="OK" MinWidth="75" IsDefault="True" HorizontalContentAlignment="Center" />
      <Button x:Name="Cancel" Content="Cancel" MinWidth="75" IsCancel="True" HorizontalContentAlignment="Center" />
    </StackPanel>
  </StackPanel>
</Window>
