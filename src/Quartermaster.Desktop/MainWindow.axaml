<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="using:Quartermaster.Desktop.Shell"
        xmlns:phases="using:Quartermaster.Desktop.Phases"
        x:Class="Quartermaster.Desktop.MainWindow"
        Title="Quartermaster"
        Width="1024" Height="768">
  <DockPanel>
    <Menu x:Name="MainMenu" DockPanel.Dock="Top" />
    <shell:MainToolbar x:Name="ToolbarHost" DockPanel.Dock="Top" />
    <phases:PhaseStrip x:Name="StripHost" DockPanel.Dock="Top" />
    <shell:AlertBar x:Name="AlertBarHost" DockPanel.Dock="Top" />
    <!-- Status bar as WinForms MainForm: module | message (springs) | tiling progress | turn | location (170) | zoom (50) -->
    <Border Classes="status" DockPanel.Dock="Bottom" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto,170,50" Height="22">
        <Border Grid.Column="0" BorderBrush="{DynamicResource Classic.BorderBrush}" BorderThickness="0,0,1,0" Padding="4,0">
          <TextBlock x:Name="SbModule" Text="No module" VerticalAlignment="Center" />
        </Border>
        <TextBlock x:Name="SbMessage" Grid.Column="1" VerticalAlignment="Center" Margin="4,0" TextTrimming="CharacterEllipsis" />
        <ProgressBar x:Name="SbTiling" Grid.Column="2" Width="100" Height="14" Minimum="0" Maximum="100" IsVisible="False" Margin="4,0" />
        <Border x:Name="SbTurnBox" Grid.Column="3" BorderBrush="{DynamicResource Classic.BorderBrush}" BorderThickness="1,0,0,0" Padding="4,0" IsVisible="False">
          <TextBlock x:Name="SbTurn" Text="Turn 1" VerticalAlignment="Center" />
        </Border>
        <Border Grid.Column="4" BorderBrush="{DynamicResource Classic.BorderBrush}" BorderThickness="1,0,0,0" Padding="4,0">
          <TextBlock x:Name="SbLocation" Text="-" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </Border>
        <Border Grid.Column="5" BorderBrush="{DynamicResource Classic.BorderBrush}" BorderThickness="1,0,0,0" Padding="4,0">
          <TextBlock x:Name="SbZoom" Text="-" VerticalAlignment="Center" />
        </Border>
      </Grid>
    </Border>
    <!-- The log docks under the maps and palette, like the WinForms default layout (170 high, 4 splitter) -->
    <Grid x:Name="BodyAndLog" RowDefinitions="*,0,0">
      <!-- Left column (WinForms: module tree over tables tree, 220 wide, split 0.6 / 0.4 by default) beside the maps and palette -->
      <Grid x:Name="BodyWithTree" ColumnDefinitions="220,4,*">
        <Grid x:Name="LeftColumnGrid" RowDefinitions="0.6*,4,0.4*">
          <shell:ModuleTree x:Name="ModuleTreeHost" />
          <GridSplitter x:Name="LeftSplitter" Grid.Row="1" ResizeDirection="Rows" HorizontalAlignment="Stretch" />
          <shell:TablesTree x:Name="TablesTreeHost" Grid.Row="2" />
        </Grid>
        <GridSplitter x:Name="LeftColumnSplitter" Grid.Column="1" ResizeDirection="Columns" />
      <Grid x:Name="Body" Grid.Column="2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="0" />
          <ColumnDefinition Width="0" />
          <ColumnDefinition Width="0" />
          <ColumnDefinition Width="0" />
        </Grid.ColumnDefinitions>
        <!-- Classic control colour behind the tab strip (WinForms DocumentTabStrip); the AppWorkspace grey is the MapView's own "no game" backdrop -->
        <Border Background="{DynamicResource Classic.FaceBrush}">
          <shell:MapTabs x:Name="Maps" />
        </Border>
        <GridSplitter x:Name="PaletteSplitter" Grid.Column="1" ResizeDirection="Columns" IsVisible="False" />
        <shell:PaletteDock x:Name="PaletteHost" Grid.Column="2" IsVisible="False" />
        <GridSplitter x:Name="PhaseSplitter" Grid.Column="3" ResizeDirection="Columns" IsVisible="False" />
        <Border x:Name="PhaseHost" Grid.Column="4" IsVisible="False" />
      </Grid>
      </Grid>
      <GridSplitter x:Name="LogSplitter" Grid.Row="1" ResizeDirection="Rows" HorizontalAlignment="Stretch" IsVisible="False" />
      <Border x:Name="LogHost" Grid.Row="2" IsVisible="False" />
    </Grid>
  </DockPanel>
</Window>
