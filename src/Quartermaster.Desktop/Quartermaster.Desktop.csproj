<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Quartermaster</AssemblyName>
    <RootNamespace>Quartermaster.Desktop</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Quartermaster.Desktop.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Quartermaster.Core\Quartermaster.Core.csproj" />
    <ProjectReference Include="..\Quartermaster.Vassal\Quartermaster.Vassal.csproj" />
    <ProjectReference Include="..\Quartermaster.Render\Quartermaster.Render.csproj" />
    <ProjectReference Include="..\Quartermaster.Documents\Quartermaster.Documents.csproj" />
  </ItemGroup>

  <!--
    Version gate (port stage 1, Task 1): Avalonia.Skia 12.1.5 asks for SkiaSharp >= 3.119.4, but Render already runs on SkiaSharp 4.154.0 and
    only one native libSkiaSharp may live in a process. SkiaSharp and every native-asset package Avalonia pulls in are pinned to 4.154.0 here;
    Quartermaster.Desktop.Tests (SkiaInteropTests) proves Avalonia's Skia backend and Render.MapRenderer share that one native library.
  -->
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.5" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.5" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.5" />
    <PackageReference Include="Avalonia.Headless" Version="12.1.5" />
    <PackageReference Include="Avalonia.Themes.Simple" Version="12.1.5" />
    <PackageReference Include="SkiaSharp" Version="4.154.0" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="4.154.0" />
    <PackageReference Include="SkiaSharp.NativeAssets.WebAssembly" Version="4.154.0" />
    <PackageReference Include="HarfBuzzSharp" Version="14.2.0" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" Version="14.2.0" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.WebAssembly" Version="14.2.0" />
  </ItemGroup>

  <!--
    Windows OCR plugin (port stage 4a, Scope rulings): when this app is built for Windows (a win-* RID, or no RID on a Windows host)
    Quartermaster.OcrWindows is built (never referenced: no assembly of it is compiled against) and the plugin's own files are copied
    to ocr-windows/ beside the app, so they also reach Desktop.Tests and the publish folder. Render and SkiaSharp are never copied
    there: the plugin load context (Documents/OcrPluginLoadContext) takes them from the app. Mac and Linux builds never touch it.
  -->
  <PropertyGroup>
    <_QmOcrWindows Condition="('$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Windows'))) or $(RuntimeIdentifier.StartsWith('win'))">true</_QmOcrWindows>
    <_QmOcrWindowsProject>$(MSBuildThisFileDirectory)..\Quartermaster.OcrWindows\Quartermaster.OcrWindows.csproj</_QmOcrWindowsProject>
  </PropertyGroup>

  <ItemGroup Condition="'$(_QmOcrWindows)' == 'true'">
    <ProjectReference Include="$(_QmOcrWindowsProject)" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" Private="false"
                      GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained;PublishDir;_IsPublishing" />
  </ItemGroup>

  <Target Name="QmAddOcrWindowsPlugin" BeforeTargets="AssignTargetPaths" Condition="'$(_QmOcrWindows)' == 'true'">
    <MSBuild Projects="$(_QmOcrWindowsProject)" Targets="GetTargetPath" Properties="Configuration=$(Configuration)" RemoveProperties="RuntimeIdentifier;SelfContained;PublishDir;_IsPublishing;TargetFramework">
      <Output TaskParameter="TargetOutputs" ItemName="_QmOcrWindowsTarget" />
    </MSBuild>
    <PropertyGroup>
      <_QmOcrWindowsDir>@(_QmOcrWindowsTarget->'%(RootDir)%(Directory)')</_QmOcrWindowsDir>
    </PropertyGroup>
    <ItemGroup>
      <_QmOcrWindowsFile Include="$(_QmOcrWindowsDir)Quartermaster.OcrWindows.dll;$(_QmOcrWindowsDir)Quartermaster.OcrWindows.deps.json;$(_QmOcrWindowsDir)WinRT.Runtime.dll;$(_QmOcrWindowsDir)Microsoft.Windows.SDK.NET.dll" />
      <None Include="@(_QmOcrWindowsFile)" Link="ocr-windows\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

  <!--
    Licence notices travel with the binaries: the publish folder gets LICENSE, THIRD-PARTY-NOTICES.md and LICENSES/ (the texts for the bundled
    PDFium, Tesseract, Leptonica and other native libraries). build/check-publish-natives.sh requires them.
  -->
  <Target Name="CopyLicenceNotices" AfterTargets="Publish">
    <PropertyGroup>
      <_QmRepoDir>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', '..'))</_QmRepoDir>
      <_QmPubDir>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(PublishDir)'))</_QmPubDir>
    </PropertyGroup>
    <ItemGroup>
      <_QmLicenceText Include="$(_QmRepoDir)LICENSES\**\*" />
    </ItemGroup>
    <Copy SourceFiles="$(_QmRepoDir)LICENSE;$(_QmRepoDir)THIRD-PARTY-NOTICES.md" DestinationFolder="$(_QmPubDir)" />
    <Copy SourceFiles="@(_QmLicenceText)" DestinationFiles="@(_QmLicenceText->'$(_QmPubDir)LICENSES\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>

  <!--
    Self-update needs four more things in the publish folder (port stage 6a, Task 8), made in this order by QmFinishPublish:
    the updater helper (published self-contained single-file by its own project, no ProjectReference so its runtime never enters the
    app's deps.json), the package marker quartermaster-package.json, on Windows Quartermaster.App.exe (a copy of the app host: the
    WinForms 0.1.0 updater restarts that name, so this is the switch-over path), and last the file list quartermaster-files.txt.
    QmPackageKind overrides the marker's package kind (the installer/AppImage/deb/rpm packaging sets it); by default it follows the RID.
  -->
  <Target Name="QmFinishPublish" AfterTargets="Publish" Condition="'$(RuntimeIdentifier)' != ''"
          DependsOnTargets="CopyLicenceNotices;QmPublishUpdaterHelper;QmWritePackageMarker;QmCopyAppHost;QmWriteFileList" />

  <Target Name="QmPublishUpdaterHelper">
    <PropertyGroup>
      <_QmHelperPublishDir>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(PublishDir)'))</_QmHelperPublishDir>
    </PropertyGroup>
    <!-- Restore runs in its own evaluation (a fresh session id), as NuGet requires, then the publish. -->
    <MSBuild Projects="..\Quartermaster.Updater\Quartermaster.Updater.csproj" Targets="Restore"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=true;MSBuildRestoreSessionId=$([System.Guid]::NewGuid())" />
    <MSBuild Projects="..\Quartermaster.Updater\Quartermaster.Updater.csproj" Targets="Publish"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=true;PublishSingleFile=true;EnableCompressionInSingleFile=true;DebugType=none;PublishDir=$(_QmHelperPublishDir)" />
  </Target>

  <Target Name="QmWritePackageMarker">
    <PropertyGroup>
      <_QmPubDir>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(PublishDir)'))</_QmPubDir>
      <_QmKind>$(QmPackageKind)</_QmKind>
      <_QmKind Condition="'$(_QmKind)' == '' and $(RuntimeIdentifier.StartsWith('win'))">win-zip</_QmKind>
      <_QmKind Condition="'$(_QmKind)' == '' and $(RuntimeIdentifier.StartsWith('osx'))">mac-app</_QmKind>
      <_QmKind Condition="'$(_QmKind)' == ''">linux-tar</_QmKind>
    </PropertyGroup>
    <WriteLinesToFile File="$(_QmPubDir)quartermaster-package.json" Lines="{&quot;version&quot;:&quot;$(Version)&quot;,&quot;package&quot;:&quot;$(_QmKind)&quot;}" Overwrite="true" />
  </Target>

  <Target Name="QmCopyAppHost" Condition="$(RuntimeIdentifier.StartsWith('win'))">
    <PropertyGroup>
      <_QmPubDir>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(PublishDir)'))</_QmPubDir>
    </PropertyGroup>
    <Copy SourceFiles="$(_QmPubDir)$(AssemblyName).exe" DestinationFiles="$(_QmPubDir)Quartermaster.App.exe" />
  </Target>

  <!-- quartermaster-files.txt: every file of the publish folder (relative, forward slashes, the list itself included), written last. -->
  <Target Name="QmWriteFileList">
    <PropertyGroup>
      <_QmPubDir>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(PublishDir)'))</_QmPubDir>
      <_QmListName>quartermaster-files.txt</_QmListName>
    </PropertyGroup>
    <ItemGroup>
      <_QmPubFile Include="$(_QmPubDir)**\*" Exclude="$(_QmPubDir)$(_QmListName)" />
      <_QmPubLine Include="@(_QmPubFile->'%(RecursiveDir)%(Filename)%(Extension)'->Replace('\', '/'))" />
      <_QmPubLine Include="$(_QmListName)" />
    </ItemGroup>
    <WriteLinesToFile File="$(_QmPubDir)$(_QmListName)" Lines="@(_QmPubLine)" Overwrite="true" WriteOnlyWhenDifferent="false" />
  </Target>

</Project>
