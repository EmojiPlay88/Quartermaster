<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Quartermaster.Vassal\Quartermaster.Vassal.csproj" />
    <ProjectReference Include="..\Quartermaster.Core\Quartermaster.Core.csproj" />
    <ProjectReference Include="..\Quartermaster.Render\Quartermaster.Render.csproj" />
    <ProjectReference Include="..\Quartermaster.Ocr\Quartermaster.Ocr.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <PackageReference Include="SkiaSharp.Views.WindowsForms" Version="4.154.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationDefaultFont>Tahoma, 8.25pt</ApplicationDefaultFont>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!--
    The updater helper ships next to the app exe as a self-contained single-file Quartermaster.Updater.exe. It is published by its own
    project into this publish folder after the app's publish (no ProjectReference, so its runtime never enters the app's deps.json).
  -->
  <Target Name="PublishUpdaterHelper" AfterTargets="Publish" Condition="'$(RuntimeIdentifier)' != ''">
    <PropertyGroup>
      <_QmHelperPublishDir>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(PublishDir)'))</_QmHelperPublishDir>
    </PropertyGroup>
    <!-- Restore runs in its own evaluation (a fresh session id), as NuGet requires, then the publish. -->
    <MSBuild Projects="..\Quartermaster.Updater\Quartermaster.Updater.csproj" Targets="Restore"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=true;MSBuildRestoreSessionId=$([System.Guid]::NewGuid())" />
    <MSBuild Projects="..\Quartermaster.Updater\Quartermaster.Updater.csproj" Targets="Publish"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=true;PublishSingleFile=true;DebugType=none;PublishDir=$(_QmHelperPublishDir)" />
    <Message Importance="high" Text="Updater helper published to $(_QmHelperPublishDir)Quartermaster.Updater.exe" />
  </Target>

</Project>