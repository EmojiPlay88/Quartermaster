<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Quartermaster.Vassal\Quartermaster.Vassal.csproj" />
    <ProjectReference Include="..\Quartermaster.Core\Quartermaster.Core.csproj" />
    <ProjectReference Include="..\Quartermaster.Render\Quartermaster.Render.csproj" />
    <ProjectReference Include="..\Quartermaster.Ocr\Quartermaster.Ocr.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <PackageReference Include="SkiaSharp.Views.WindowsForms" Version="4.154.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationDefaultFont>Tahoma, 8.25pt</ApplicationDefaultFont>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!--
    The updater helper ships next to the app exe as a self-contained single-file Quartermaster.Updater.exe. It is published by its own
    project into this publish folder after the app's publish (no ProjectReference, so its runtime never enters the app's deps.json).
  -->
  <Target Name="PublishUpdaterHelper" AfterTargets="Publish" Condition="'$(RuntimeIdentifier)' != ''">
    <PropertyGroup>
      <_QmHelperPublishDir>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(PublishDir)'))</_QmHelperPublishDir>
    </PropertyGroup>
    <!-- Restore runs in its own evaluation (a fresh session id), as NuGet requires, then the publish. -->
    <MSBuild Projects="..\Quartermaster.Updater\Quartermaster.Updater.csproj" Targets="Restore"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=true;MSBuildRestoreSessionId=$([System.Guid]::NewGuid())" />
    <MSBuild Projects="..\Quartermaster.Updater\Quartermaster.Updater.csproj" Targets="Publish"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=true;PublishSingleFile=true;EnableCompressionInSingleFile=true;DebugType=none;PublishDir=$(_QmHelperPublishDir)" />
    <Message Importance="high" Text="Updater helper published to $(_QmHelperPublishDir)Quartermaster.Updater.exe" />
  </Target>

  <!--
    quartermaster-files.txt: every file of the publish folder (relative, forward slashes, the list itself included). The updater helper only
    ever moves or deletes files named in it, so a user's own files in the app folder are left alone; a folder without it can't self-update.
    Runs after the helper and the licence files are in the publish folder, so build/release.ps1 gets it too.
  -->
  <Target Name="WriteReleaseFileList" AfterTargets="PublishUpdaterHelper" Condition="'$(RuntimeIdentifier)' != ''">
    <PropertyGroup>
      <_QmPubDir>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(PublishDir)'))</_QmPubDir>
      <_QmListName>quartermaster-files.txt</_QmListName>
    </PropertyGroup>
    <Copy SourceFiles="$(MSBuildThisFileDirectory)..\..\LICENSE;$(MSBuildThisFileDirectory)..\..\THIRD-PARTY-NOTICES.md" DestinationFolder="$(_QmPubDir)"
          Condition="Exists('$(MSBuildThisFileDirectory)..\..\LICENSE') And Exists('$(MSBuildThisFileDirectory)..\..\THIRD-PARTY-NOTICES.md')" />
    <ItemGroup>
      <_QmPubFile Include="$(_QmPubDir)**\*" Exclude="$(_QmPubDir)$(_QmListName)" />
      <_QmPubLine Include="@(_QmPubFile->'%(RecursiveDir)%(Filename)%(Extension)'->Replace('\', '/'))" />
      <_QmPubLine Include="$(_QmListName)" />
    </ItemGroup>
    <WriteLinesToFile File="$(_QmPubDir)$(_QmListName)" Lines="@(_QmPubLine)" Overwrite="true" WriteOnlyWhenDifferent="false" />
    <Message Importance="high" Text="Release file list written to $(_QmPubDir)$(_QmListName)" />
  </Target>

</Project>